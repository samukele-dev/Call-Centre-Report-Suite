# Copy to frontend/.env.local and fill in for a non-default backend URL.
# Not needed for local `npm start` at all — apiConfig.js/AuthContext.js
# both fall back to http://localhost:8000 when this is unset.
#
# CRA bakes REACT_APP_* vars into the build at BUILD time, not read at
# runtime — for a Render deployment this is set as a build-time env var on
# the frontend static site service (see render.yaml), not in a .env file.
REACT_APP_API_URL=http://localhost:8000
