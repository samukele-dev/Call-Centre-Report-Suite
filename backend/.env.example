# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# External call-centre database (PostgreSQL, the source HeidiSQL connects to)
# that "Sync from database" pulls campaign call data from.
SOURCE_DB_HOST=
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
