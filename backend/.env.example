# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.
#
# For a Render deployment specifically, these are NOT set via a .env file
# at all (there is none in the deployed container — it's gitignored) but as
# real environment variables in the Render dashboard / render.yaml. This
# file exists for local `manage.py runserver` use and as documentation of
# every variable the app reads from its environment either way.

# External call-centre database (PostgreSQL, the source HeidiSQL connects to)
# that "Sync from database" pulls campaign call data from. Always required,
# locally and on Render alike — this is a separate database from the app's
# own (see DATABASE_URL below), and has no default/fallback.
SOURCE_DB_HOST=
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=

# ── Everything below is only relevant for a deployed (Render) environment —
#    each one has a working local-dev default and can stay unset here. ────

# A real Django secret key. render.yaml generates one automatically
# (generateValue: true) — set explicitly only if deploying by hand instead
# of via the Blueprint. Never reuse the insecure default settings.py falls
# back to for local dev.
SECRET_KEY=

# Falls back to True (matching the old hardcoded behaviour) when unset —
# Render's render.yaml sets this to False explicitly for the deployed
# service. Never run with DEBUG=True against a real deployment: it leaks
# stack traces (including this app's own source and environment) to any
# visitor who hits an error.
DEBUG=False

# Comma-separated hostnames this Django instance will answer requests for.
# Render's own *.onrender.com domain for this service is added
# automatically (see settings.py) without needing to be listed here too —
# only set this for an additional custom domain.
ALLOWED_HOSTS=

# This app's OWN database (ProcessedData, GeneratedReport, Campaign, etc.)
# — NOT the external call-centre source DB above. Render sets this
# automatically once a Postgres instance is attached via render.yaml's
# `fromDatabase` reference. Falls back to local SQLite when unset — see
# settings.py's DATABASES comment for why SQLite specifically doesn't work
# on Render (its filesystem is ephemeral; Postgres is a separate,
# persistent managed instance).
DATABASE_URL=

# Comma-separated origins the deployed React frontend is served from, e.g.
# https://call-centre-frontend.onrender.com — without this, the browser
# blocks the frontend's API calls to this backend (CORS) and Django
# rejects its POSTs (CSRF) once both are running on real https:// domains
# instead of localhost.
CORS_ALLOWED_ORIGINS=

# Login user build.sh creates automatically on every deploy if it doesn't
# already exist yet (see create_test_user.py — get_or_create, so this is
# safe to run unattended on every build). No password default — leaving
# TEST_USER_PASSWORD blank skips creating the user entirely rather than
# falling back to anything guessable, since this can run against a real
# deployment handling real PII. Changing it later does nothing to a user
# that already exists (its password isn't reset on repeat runs) — change
# the password via /admin/ instead at that point.
TEST_USER_USERNAME=admin
TEST_USER_EMAIL=admin@altitudebpo.co.za
TEST_USER_PASSWORD=
